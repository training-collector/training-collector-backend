SERVER_PORT=8080
DB_PORT=5433
DB_NAME=training
DB_USER=training_app
DB_PASSWORD=
AUTH_SERVICE_KEY=
TRAINING_SERVICE_KEY=
ADMIN_LOGIN=
ADMIN_PASSWORD=
# Production: https://<auth-bot-domain>/api/wake
# AUTH_DISPATCH_URL=
# A separate key for delivery wake-ups (also set it in the auth bot project). Defaults to AUTH_SERVICE_KEY.
# AUTH_WAKE_KEY=
# A stable secret for login codes and token tags: openssl rand -hex 32
# APP_SECRET=
# Behind your own proxy: the header that carries the client address, e.g. X-Real-IP
# CLIENT_IP_HEADER=
# Production: apply migrations as a deployment step and start without a database connection
# DB_MIGRATE_ON_START=false
# All limits and lifetimes are listed with their defaults in src/main/resources/application.conf
